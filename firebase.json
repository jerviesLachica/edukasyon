{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "studentai-download",
      "public": "download-site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "downloads/**"
      ],
      "headers": [
        {
          "source": "/version.json",
          "headers": [
            { "key": "Cache-Control", "value": "max-age=60" }
          ]
        },
        {
          "source": "/js/config.js",
          "headers": [
            { "key": "Cache-Control", "value": "max-age=300" }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "max-age=300" }
          ]
        }
      ]
    }
  ],
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "SchedMate",
        "supportEmail": "lachicajervies@gmail.com"
      }
    }
  }
}
