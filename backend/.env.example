# Copy to .env for local dev (never commit .env)
AI_API_KEY=YOUR_API_KEY
# Vision model for image attachments (Gizmo chat photos, schedule scanner)
# agentrouter.org slugs: claude-opus-4-8 (Opus 4.8) or claude-opus-5 (Pro)
# Android Profile → AI Settings picks Standard/Pro for vision chats only.
AI_MODEL=claude-opus-4-8
# Text-only chat and study tools (summarize, flashcards, quiz, study-plan)
TEXT_MODEL=claude-opus-4-8
AI_BASE_URL=https://agentrouter.org/v1
# Required by agentrouter.org for server-side API calls (do not use a generic browser UA)
AI_USER_AGENT=QwenCode/0.2.0 (linux; x64)
PORT=8080

# Render (production): set these in Dashboard → studentai-backend → Environment
#   AI_API_KEY  = your agentrouter.org key (Secret, sync: false in render.yaml)
#   AI_MODEL    = claude-opus-4-8 or claude-opus-5 (vision default)
#   TEXT_MODEL  = claude-opus-4-8 (text-only chat and study tools)
#   AI_BASE_URL = https://agentrouter.org/v1
#   AI_USER_AGENT = QwenCode/0.2.0 (linux; x64)
# PORT is injected automatically by Render — do not set it manually.
# The Android app calls the Render backend URL only — never agentrouter.org directly.
