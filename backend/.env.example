# Primary AI Provider (hcnsec.cn)
AI_API_KEY=sk-...your-api-key-here...
AI_BASE_URL=https://api.hcnsec.cn/v1
TEXT_MODEL=auto
VISION_MODEL=step-3.7-flash

# Multi-Provider Round-Robin & Circuit-Breaker Failover (100% Free / $0 Cost)
# Set to 'true' to rotate healthy providers across requests and pool rate limits.
ROUND_ROBIN_ENABLED=true

# 1. Groq (Free: 30 RPM, 14,400 RPD, ~500 tok/s) — Get key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# 2. Google Gemini (Free: 15 RPM, 1,500 RPD, 1M TPM) — Get key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash

# 3. OpenRouter (Free: 20 RPM on :free models) — Get key at https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# 4. Cerebras (Free: 30 RPM, 1M TPM) — Get key at https://cloud.cerebras.ai
# CEREBRAS_API_KEY=csk-...
# CEREBRAS_MODEL=llama-3.3-70b
# CEREBRAS_FAST_MODEL=llama3.1-8b

# 5. OrcaRouter (Free: 10 RPM fast vision fallback) — https://orcarouter.ai
# ORCA_API_KEY=
# ORCA_MODEL=z-ai/glm-5.3-flash-free

# Server
PORT=8080

# Optional: Web search
TAVILY_API_KEY=optional

# Firebase (optional, for schedule sync)
FIREBASE_PROJECT_ID=edukasyon-studentai
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Safety & Rate Limiting
SAFETY_REQUEST_TIMEOUT_MS=90000
SAFETY_SCHEDULE_ANALYSIS_REQUEST_TIMEOUT_MS=300000
SAFETY_RATE_PER_MIN=60
SAFETY_BURST_PER_MIN=10
SAFETY_DAILY_QUOTA=2000
SAFETY_HOURLY_QUOTA=200
