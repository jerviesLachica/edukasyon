# Copy to .env for local dev (never commit .env)

# Text provider (hcnsec.cn) — text-only chat + study tools
TEXT_AI_BASE_URL=https://api.hcnsec.cn/v1
TEXT_AI_API_KEY=YOUR_HCNSEC_API_KEY
TEXT_MODEL=auto

# Vision provider (freetokenfaucet.com) — image chat + schedule scanner
# Android Profile → AI Settings picks Standard (mimo-v2.5) or Pro (mimo-v2.5-pro) for vision chats only.
VISION_AI_BASE_URL=https://freetokenfaucet.com/v1
VISION_AI_API_KEY=YOUR_FREETOKENFAUCET_API_KEY
VISION_MODEL=mimo-v2.5-pro

PORT=8080

# Render (production): set these in Dashboard → studentai-backend → Environment
#   TEXT_AI_BASE_URL     = https://api.hcnsec.cn/v1
#   TEXT_AI_API_KEY      = your hcnsec key (Secret, sync: false in render.yaml)
#   TEXT_MODEL           = auto
#   VISION_AI_BASE_URL   = https://freetokenfaucet.com/v1
#   VISION_AI_API_KEY    = your freetokenfaucet key (Secret, sync: false in render.yaml)
#   VISION_MODEL         = mimo-v2.5-pro (or mimo-v2.5 for Standard)
# PORT is injected automatically by Render — do not set it manually.
# The Android app calls the Render backend URL only — never provider APIs directly.
