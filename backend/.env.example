# Copy to .env for local dev (never commit .env)

# Single AI provider (hcnsec.cn)
AI_BASE_URL=https://api.hcnsec.cn/v1
AI_API_KEY=YOUR_HCNSEC_API_KEY
AI_MODEL=auto
TEXT_MODEL=auto
VISION_MODEL=step-3.7-flash
# Optional web search for chat messages starting with /search
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
# Aliases (optional, same as TEXT_MODEL / VISION_MODEL):
# AI_TEXT_MODEL=auto
# AI_VISION_MODEL=step-3.7-flash

PORT=8080

# ── AI Safety Gateway (optional — defaults shown) ───────────────────────────
# SAFETY_MAX_INPUT_CHARS=32000
# SAFETY_MAX_IMAGE_BYTES=6000000
# SAFETY_DAILY_QUOTA=200
# SAFETY_HOURLY_QUOTA=60
# Chat has no per-minute rate limit by default; hourly and daily quotas still apply.
# SAFETY_STEP_MODEL_CHAT_LIMIT=25
# SAFETY_STEP_MODEL_CHAT_WINDOW_MS=600000
# SAFETY_MODERATION_ENABLED=true
# SAFETY_REQUIRE_DEVICE_ID=false

# Render (production): set these in Dashboard → studentai-backend → Environment
#   AI_BASE_URL   = https://api.hcnsec.cn/v1
#   AI_API_KEY    = your hcnsec key (Secret, sync: false in render.yaml)
#   AI_MODEL      = auto
#   TEXT_MODEL    = auto
#   VISION_MODEL  = step-3.7-flash
# PORT is injected automatically by Render — do not set it manually.
# The Android app calls the Render backend URL only — never provider APIs directly.
